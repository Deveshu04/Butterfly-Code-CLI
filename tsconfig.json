{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "paths": {
      "@butterfly/core": ["./packages/core/src/index.ts"],
      "@butterfly/core/*": ["./packages/core/src/*"],
      "@butterfly/tui": ["./packages/tui/src/index.tsx"]
    }
  },
  "include": ["packages/*/src/**/*", "packages/*/test/**/*"]
}
